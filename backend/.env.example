# Backend Environment Variables
# Copy to .env and fill in values

PORT=3000

# PostgreSQL
POSTGRES_USER=my_secure_user
POSTGRES_PASSWORD=my_super_secret_password
POSTGRES_DB=inventory_production

NODE_ENV=production
REDPANDA_BROKERS=redpanda:9092

DATABASE_URL=postgresql://<username>:password@localhost:<port>/your_db_name

# Kafka
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=inventory-service
KAFKA_GROUP_ID=inventory-consumer-group
KAFKA_TOPIC=inventory-events

# JWT
JWT_SECRET=change-this-to-a-strong-secret-in-production

# Admin credentials (password hash generated with bcryptjs)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$placeholder

# Frontend URL for CORS
FRONTEND_URL=http://localhost:4200
